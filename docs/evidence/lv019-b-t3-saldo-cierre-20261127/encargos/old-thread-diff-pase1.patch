@@ -260,6 +260,15 @@ async function resolveAccountGuard(tx:Transaction,deps:UnblockDeps,videoAccountI
   if(accountIdentity.get('uid')!==video.uid)throw Object.assign(new UnblockFault('conflict'),{stage:'account_identity_uid'});
   const accountIdCuenta=accountIdentity.get('accountId');
   if(typeof accountIdCuenta!=='string'||!uuid.test(accountIdCuenta))throw Object.assign(new UnblockFault('conflict'),{stage:'account_identity_account'});
+  // Bind the derived account to THIS identity in the SAME transaction: the account document must exist and name
+  // the identity with the AccountStore schema/unit. A swapped accountId (identity A pointing at account B) is
+  // rejected here, before B's guard is ever read or written; the read stays in the read set, so a concurrent
