# Server-only key. Never prefix this with VITE_ or commit .env.local.
GEMINI_API_KEY=

# Optional server configuration.
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
HOST=127.0.0.1

# Public Firebase Web configuration is supplied to the browser by the backend.
# Keep project environments separate. Never put Admin credentials in these values.
LINGUISTVISION_FIREBASE_PROJECT_ID=
LINGUISTVISION_FIREBASE_WEB_CONFIG=
# WEB_CONFIG format: {"apiKey":"public-web-key","authDomain":"project.firebaseapp.com","projectId":"project","appId":"web-app-id"}
# Server authentication uses external Application Default Credentials locally,
# and a dedicated managed runtime identity in Google Cloud. No service-account JSON here.
