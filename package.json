{
  "name": "linguistvision:-ai-video-translator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:vite": "vite",
    "build": "vite build && vite build --config vite.pilot.config.ts",
    "start": "tsx server/index.ts --production",
    "preview": "tsx server/index.ts --production",
    "pilot:local": "tsx server/commercial/pilotLocal.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude \"outputs/**\"",
    "test:review-guard:windows": "node scripts/reviewEmulatorNetworkGuard.windows.cjs",
    "test:firestore": "node --no-network-family-autoselection --import tsx --test server/commercial/firestoreBackend.emulator.mjs server/commercial/firestoreTransport.emulator.mjs server/commercial/firestoreFiles.emulator.mjs server/commercial/firestoreAiBackend.emulator.mjs server/commercial/firestoreAi.emulator.mjs server/commercial/cloudDiagnostics.emulator.mjs server/commercial/cloudCandidateLimits.emulator.mjs server/commercial/cloudEnqueueRecovery.emulator.mjs server/commercial/firestoreSilentContract.emulator.mjs server/commercial/firestoreAiAccess.emulator.mjs",
    "emulator:firestore": "firebase emulators:start --only firestore --project demo-vistavo-ledger --config deploy/google-cloud/firebase.emulators.json",
    "emulator:candidate": "firebase emulators:start --only auth,firestore --project demo-vistavo-ledger --config deploy/google-cloud/firebase.emulators.json",
    "candidate:isolated": "node --no-network-family-autoselection --import tsx server/commercial/startIsolatedCandidate.mjs",
    "test:candidate:isolated": "node --no-network-family-autoselection --import tsx --test server/commercial/isolatedCandidateLocal.emulator.mjs",
    "candidate:cloud:local": "node --no-network-family-autoselection --import tsx server/commercial/cloudCandidateLocal.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^1.38.0",
    "@noble/hashes": "2.4.0",
    "@supabase/supabase-js": "2.119.0",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "10.9.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
