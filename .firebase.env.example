# Public Firebase Web configuration only. Copy OUTSIDE the repository as .firebase.env.
# Obtain these settings from your own LinguistVision Firebase project.
# Never place a service-account JSON, private key, access token or client secret here.
LINGUISTVISION_FIREBASE_PROJECT_ID=your-linguistvision-project
LINGUISTVISION_FIREBASE_WEB_CONFIG={"apiKey":"REPLACE_WITH_WEB_API_KEY","authDomain":"your-linguistvision-project.firebaseapp.com","projectId":"your-linguistvision-project","appId":"REPLACE_WITH_WEB_APP_ID"}
